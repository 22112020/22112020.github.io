(function() {
  TGQ.init();

  const NAV_ITEMS = [
    { route: 'dashboard', icon: 'dashboard', label: 'Dashboard' },
    { route: 'markets', icon: 'grid_view', label: 'Markets' },
    { route: 'analysis', icon: 'analytics', label: 'Analysis' },
    { route: 'results', icon: 'history', label: 'Results' },
    { route: 'input', icon: 'edit_note', label: 'Input' },
    { route: 'about', icon: 'info', label: 'About' },
  ];

  function renderNav(container, isBottom) {
    container.innerHTML = NAV_ITEMS.map(item => `
      <a class="${isBottom ? 'bottom-nav-item' : 'nav-item'}" href="#/${item.route}" data-route="${item.route}">
        <span class="material-icons">${item.icon}</span>
        ${isBottom ? `<span>${item.label}</span>` : item.label}
      </a>
    `).join('');
  }

  renderNav(document.getElementById('sidebarNav'), false);
  renderNav(document.getElementById('bottomNav'), true);

  document.getElementById('sidebarNav').addEventListener('click', (e) => {
    const a = e.target.closest('.nav-item');
    if (a && window.innerWidth <= 1024) {
      document.getElementById('sidebar').classList.remove('open');
    }
  });

  async function updateStatus() {
    const dot = document.getElementById('statusDot');
    const label = document.getElementById('statusLabel');
    const uptime = document.getElementById('uptimeLabel');

    try {
      const s = await API.status();
      dot.className = 'status-dot online';
      label.textContent = 'Online';
      uptime.textContent = s.uptime ? `Uptime: ${s.uptime}` : 'Server aktif';
    } catch {
      dot.className = 'status-dot offline';
      label.textContent = 'Offline';
      uptime.textContent = '';
    }
  }

  updateStatus();
  setInterval(updateStatus, 30000);

  ROUTER.init();

  document.addEventListener('click', (e) => {
    const hamburger = e.target.closest('.hamburger');
    if (hamburger) document.getElementById('sidebar').classList.toggle('open');

    const overlay = e.target.closest('.sidebar');
    if (!overlay && window.innerWidth <= 1024) {
      document.getElementById('sidebar').classList.remove('open');
    }
  });
})();
